# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
build/

# Environment files (never commit secrets)
.env
.env.*
!.env.example
# Client production config is committed intentionally — it holds no secrets
# (just the Render backend URL) so Vercel builds work without per-account setup.
!client/.env.production

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local Vite cache
*.local
