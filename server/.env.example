# Supabase project (Dashboard → Project Settings → API)
# Find your project URL and publishable (anon) key here:
# https://supabase.com/dashboard/project/<ref>/settings/api
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# Only needed by the local test script (server/test-channels.mjs). The API
# server does NOT use the service-role key — it acts as the authenticated
# user via the publishable key, so leave this unset for production.
# SUPABASE_SERVICE_ROLE_KEY=

# Auth redirects (Supabase Dashboard → Authentication → URL Configuration)
GOOGLE_AUTH_REDIRECT_URL=http://localhost:5173/auth/callback
PASSWORD_RESET_REDIRECT_URL=http://localhost:5173/reset-password

# Port (defaults to 4000)
PORT=4000
